{
  "name": "@nuanscape/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API backend Nuanscape.studio",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "agent:spike": "bash scripts/picoclaw-spike.sh",
    "agent:smoke": "tsx scripts/agent-smoke.ts",
    "agent:security": "bash scripts/picoclaw-security.sh",
    "agent:providers": "tsx scripts/provider-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.2",
    "@fastify/jwt": "^10.2.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/client": "6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.93.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
