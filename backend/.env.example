NODE_ENV=development
HOST=0.0.0.0
PORT=8790
DATABASE_URL=postgresql://nuanscape:nuanscape@localhost:5434/nuanscape?schema=public
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
SWAGGER_ENABLED=true
# Owner demo (fallback development + login PIN admin).
DEMO_OWNER_EMAIL=demo@nuanscape.studio
DEMO_OWNER_PASSWORD=nuanscape-demo
# Opsional: PIN admin demo (kompatibilitas FE). Kosongkan untuk menonaktifkan.
DEMO_ADMIN_PIN=1234
# Wajib di production, minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
# Access token 15 menit, refresh token 30 hari (detik).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Agent runtime: picoclaw (LLM KIE/NVIDIA, sidecar read-only) atau deterministic.
AGENT_RUNTIME=picoclaw
PICOCLAW_BIN=./agents/picoclaw/bin/picoclaw
PICOCLAW_CONFIG=./agents/picoclaw/config.json
PICOCLAW_HOME=./agents/picoclaw/.runtime
PICOCLAW_WORKDIR=./agents/picoclaw
# PICOCLAW_MODEL=kie-gemini
PICOCLAW_TIMEOUT_MS=240000
# Provider keys untuk agents/picoclaw/.security.yml (jangan commit).
# Key dari dashboard (ai_provider_configs) diprioritaskan; env hanya fallback,
# termasuk untuk Suno, GPT Image 2, dan tes provider di Monitor.
# Isi lalu jalankan: bash scripts/picoclaw-security.sh
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
PICOCLAW_KIE_MODEL=kimi-k3-1-pro
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Enkripsi API key provider di database (AES-256-GCM).
# Generate: openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=
PROVIDER_ENCRYPTION_KEY_VERSION=1

# AI riset ide & naskah konten (KIE primary, NVIDIA NIM fallback).
KIE_CONTENT_MODEL=gemini-3.1-pro
NVIDIA_CONTENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Render media nyata: FFmpeg + Resvg. Batas durasi non-musik default 60 detik.
# Musik: Suno via KIE (default) atau prosedural lokal. Narasi: HeyGen TTS (default) atau edge-tts.
MEDIA_RENDER_MAX_SECONDS=60
# Batas maksimum durasi musik (detik); audio + video loop sampai durasi ini.
MEDIA_MUSIC_MAX_SECONDS=7200
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MUSIC_PROVIDER=suno
SUNO_MODEL=V6_MINI
SUNO_TIMEOUT_MS=300000
TTS_PROVIDER=heygen
HEYGEN_API_KEY=
# Public voice "Breezy Bagus" (bisa bahasa Indonesia). Ganti bila ingin voice lain.
HEYGEN_VOICE_ID=06e81a5d7c8b41818d3f0b38f7cf15a1
HEYGEN_MODEL=heygen-voice-1-turbo-free
HEYGEN_LANGUAGE=id
HEYGEN_GENDER=
HEYGEN_TIMEOUT_MS=180000
# GPT Image 2 via KIE: none | gpt-image-2
IMAGE_PROVIDER=gpt-image-2
GPT_IMAGE_MODEL=gpt-image-2-text-to-image
IMAGE_TIMEOUT_MS=240000
# IMAGE_POLL_INTERVAL_MS=3000
# Animasi AI image-to-video via KIE: kie (wajib untuk konten musik + gambar GPT Image 2,
# tanpa fallback loop lokal). Grok Imagine Video 1.5: 6 detik / 720p ≈ 27 kredit.
# Audio hasil video dibuang; klip AI di-loop apa adanya secara lokal, lalu digabung
# dengan audio tanpa animasi tambahan.
AI_VIDEO_PROVIDER=kie
KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
KIE_VIDEO_DURATION=6
KIE_VIDEO_RESOLUTION=720p
KIE_VIDEO_TIMEOUT_MS=600000
# KIE_VIDEO_POLL_INTERVAL_MS=5000
# KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
# Fallback narasi lokal bila TTS_PROVIDER=edge.
EDGE_TTS_BIN=edge-tts
EDGE_TTS_VOICE=id-ID-ArdiNeural

# YouTube Data API v3 (opsional). Buat API key di Google Cloud Console, aktifkan
# "YouTube Data API v3", lalu isi di sini untuk sinkronisasi statistik channel.
# Butuh OAuth 2.0 (bukan API key) untuk data privat/analytics watch time.
YOUTUBE_API_KEY=

# Riset tren/kompetitor untuk Bambang. Snapshot agen mengisi
# content.youtubeResearch dari search.list + videos.list + channels.list.
# Tanpa API key, riset memakai access token channel YouTube yang terhubung via OAuth.
# Query kosong = pakai niche akun YouTube (fallback: niche konten YouTube).
YOUTUBE_RESEARCH_ENABLED=true
YOUTUBE_RESEARCH_QUERY=
YOUTUBE_RESEARCH_DAYS=90
YOUTUBE_RESEARCH_MAX_RESULTS=25
YOUTUBE_RESEARCH_CACHE_MS=3600000
YOUTUBE_REGION_CODE=ID
YOUTUBE_RELEVANCE_LANGUAGE=id

# YouTube OAuth 2.0 (Google Cloud Console → Credentials → OAuth client ID, tipe Web).
# Redirect URI yang didaftarkan harus sama dengan GOOGLE_OAUTH_REDIRECT_URL.
# URI ini dipakai untuk login/registrasi Google sekaligus koneksi channel YouTube.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8790/api/v1/content/youtube/oauth/callback
FRONTEND_URL=http://localhost:5173
